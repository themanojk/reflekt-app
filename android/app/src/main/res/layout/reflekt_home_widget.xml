<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="12dp"
  android:paddingEnd="14dp"
  android:paddingBottom="18dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="lOT"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_status"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="#C2E0FF"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="#33FFFFFF" />

  <TextView
    android:id="@+id/widget_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Open app to sync widget data"
    android:textColor="#CCFFFFFF"
    android:textSize="12sp"
    android:visibility="visible" />

  <LinearLayout
    android:id="@+id/widget_grid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
      android:id="@+id/widget_row_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:visibility="gone">

      <LinearLayout
        android:id="@+id/widget_slot_1"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_1_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_1_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_1_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_slot_2"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_2_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_2_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_2_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_row_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"
      android:visibility="gone">

      <LinearLayout
        android:id="@+id/widget_slot_3"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_3_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_3_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_3_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_slot_4"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_4_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_4_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_4_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_row_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"
      android:visibility="gone">

      <LinearLayout
        android:id="@+id/widget_slot_5"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_5_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_5_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_5_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_slot_6"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_6_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_6_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_6_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_row_4"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"
      android:visibility="gone">

      <LinearLayout
        android:id="@+id/widget_slot_7"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_7_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_7_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_7_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_slot_8"
        style="@style/WidgetFavoriteCellContainer">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_slot_8_title"
            style="@style/WidgetFavoriteTitle" />

          <TextView
            android:id="@+id/widget_slot_8_board"
            style="@style/WidgetFavoriteSubtitle" />
        </LinearLayout>

        <ImageView
          android:id="@+id/widget_slot_8_toggle"
          style="@style/WidgetFavoriteToggle"
          android:contentDescription="Send command" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
