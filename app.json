{
  "expo": {
    "name": "lOT",
    "slug": "reflekt",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reflekt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "19",
      "supportsTablet": false,
      "bundleIdentifier": "com.littra.reflektapp",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "lOT uses Bluetooth to connect to nearby devices.",
        "NSBluetoothPeripheralUsageDescription": "lOT uses Bluetooth to communicate with nearby accessories.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "7A2483D2W6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.littra.reflekt",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1E",
          "dark": {
            "backgroundColor": "#0A0F1E"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to Bluetooth devices"
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": ["Bluetooth"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8052d4b3-65a8-422c-85cb-b2d61f91eeaa"
      },
      "widget": {
        "appName": "lOT",
        "iosAppGroup": "group.com.littra.reflekt",
        "kind": "expo.extra.widget.kind"
      }
    },
    "owner": "themanojk"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "autoincrement": true
    }
  }
}
